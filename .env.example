# ── Database ────────────────────────────────────────────────
# Any Postgres connection string works (Neon, Supabase, Vercel Postgres, Railway).
# Neon (recommended, free): https://neon.tech  → copy the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Owner login ─────────────────────────────────────────────
# The password your mum types to reach the dashboard. Make it long.
OWNER_PASSWORD="change-this-to-something-strong"
# Used to sign the login cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET="paste-a-long-random-string-here"

# ── Email notifications (Resend) ────────────────────────────
# Get a key at https://resend.com (free tier).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Where new-order alerts are sent (your mum's inbox).
OWNER_EMAIL="kenny@example.com"
# The "from" address. In test mode use onboarding@resend.dev (only delivers to
# the Resend account owner). For real use, verify a domain in Resend and use it.
EMAIL_FROM="Baked by Kenny <onboarding@resend.dev>"

# ── Text alerts (Twilio) — optional ─────────────────────────
# Fill these in to also text the owner on each enquiry. Leave them blank to
# skip SMS. Get them from https://twilio.com (Console dashboard).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# Your Twilio phone number, in international format.
TWILIO_FROM="+447700900000"
# The owner's mobile, in international format (UK numbers start +44).
OWNER_PHONE="+447700900123"

# ── Payments (Stripe) ───────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys. Use the TEST keys first.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# After creating a webhook endpoint (see README), paste its signing secret here.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# Your live site URL, used in payment links and emails (e.g. https://bakedbykenny.co.uk).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
